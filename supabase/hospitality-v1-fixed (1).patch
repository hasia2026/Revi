+"use client";
+
+import { useState } from "react";
+import { toast } from "sonner";
+import { SUPPORTED_LOCALES, LOCALE_LABELS, type Locale } from "@/lib/i18n/config";
+import { setLocale } from "@/lib/i18n/actions";
+import { SignaturePad } from "@/components/hospitality/SignaturePad";
+import type { Reservation, RegistrationQuestion, RegistrationPolicy } from "@/lib/cu3/hospitality-types";
+import en from "../../../messages/en.json";
+import es from "../../../messages/es.json";
+import ar from "../../../messages/ar.json";
+import vi from "../../../messages/vi.json";
+
+/**
+ * Loaded directly rather than via the app-wide NextIntlClientProvider:
+ * that provider gets its locale from a cookie at page load, before an
+ * anonymous guest has picked anything — it can't retroactively reflect
+ * an in-session choice without a full page reload. This form's language
+ * selection is inherently local and immediate, so it reads its own
+ * dictionary rather than depending on the provider tree.
+ */
+const DICTIONARIES: Record<Locale, typeof en> = { en, es, ar, vi };
+
+type Props = {
+  token: string;
+  businessName: string;
+  reservation: Reservation | null;
+  questions: RegistrationQuestion[];
+  policies: RegistrationPolicy[];
+};
+
+const STEPS = ["language", "guest", "stay", "vehicle", "policies", "signature", "done"] as const;
+type Step = (typeof STEPS)[number];
+
+export function RegistrationForm({ token, businessName, reservation, questions, policies }: Props) {
+  const [step, setStep] = useState<Step>("language");
+  const [locale, setLocaleState] = useState<Locale>("en");
+  const [submitting, setSubmitting] = useState(false);
+
+  const [guest, setGuest] = useState({ first_name: "", last_name: "", email: "", phone: "", address: "" });
+  const [hasVehicle, setHasVehicle] = useState(false);
+  const [vehicle, setVehicle] = useState({ make: "", model: "", color: "", license_plate: "", parking_needed: false, valet_needed: false });
+  const [answers, setAnswers] = useState<Record<string, string>>({});
+  const [acceptedPolicies, setAcceptedPolicies] = useState<Record<string, boolean>>({});
+  const [signatureCaptured, setSignatureCaptured] = useState(false);
+
+  async function chooseLocale(l: Locale) {
+    setLocaleState(l);
+    await setLocale(l);
+    setStep("guest");
+  }
+
+  function next() {
+    const order: Step[] = ["language", "guest", "stay", "vehicle", "policies", "signature", "done"];
+    const idx = order.indexOf(step);
+    setStep(order[Math.min(idx + 1, order.length - 1)]);
+  }
+
+  function back() {
+    const order: Step[] = ["language", "guest", "stay", "vehicle", "policies", "signature", "done"];
+    const idx = order.indexOf(step);
+    setStep(order[Math.max(idx - 1, 0)]);
+  }
+
+  async function handleSubmit() {
+    const requiredPolicies = policies.filter((p) => p.required);
+    const allAccepted = requiredPolicies.every((p) => acceptedPolicies[p.id]);
+    if (!allAccepted) {
+      toast.error("Please accept all required policies to continue");
+      setStep("policies");
+      return;
+    }
+
+    setSubmitting(true);
+    const res = await fetch(`/api/guest-registration/${token}`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        guest: { ...guest, preferred_language: locale },
+        vehicle: hasVehicle ? vehicle : undefined,
+        answers: questions.map((q) => ({ question_id: q.id, value: answers[q.id] ?? "" })).filter((a) => a.value),
+        acknowledgements: policies.map((p) => ({
+          policy_id: p.id,
+          policy_version: p.version,
+          accepted: !!acceptedPolicies[p.id],
+        })),
+      }),
+    });
+
+    setSubmitting(false);
+
+    if (!res.ok) {
+      toast.error("Something went wrong. Please try again or ask the front desk for help.");
+      return;
+    }
+
+    setStep("done");
+  }
+
+  const dir = locale === "ar" ? "rtl" : "ltr";
+  const t = DICTIONARIES[locale];
+
+  return (
+    <div dir={dir} className="min-h-screen bg-charcoal-50 flex flex-col">
+      <div className="px-6 py-5 bg-white border-b border-charcoal-100">
+        <p className="text-xs text-charcoal-400 uppercase tracking-wide">{businessName}</p>
+        <h1 className="text-lg font-semibold text-charcoal-900">{t.registration.title}</h1>
+      </div>
+
+      <div className="flex-1 px-6 py-6 max-w-md mx-auto w-full">
+        {step === "language" && (
+          <div className="space-y-3">
+            <p className="text-sm font-medium text-charcoal-700 mb-4">{t.common.selectLanguage}</p>
+            {SUPPORTED_LOCALES.map((l) => (
+              <button
+                key={l}
+                onClick={() => chooseLocale(l)}
+                className="w-full text-left px-4 py-3.5 rounded-lg border border-charcoal-200 bg-white hover:border-gold-400 hover:bg-gold-50 transition-colors font-medium text-charcoal-800"
+              >
+                {LOCALE_LABELS[l]}
+              </button>
+            ))}
+          </div>
+        )}
+
+        {step === "guest" && (
+          <div className="space-y-4">
+            <h2 className="font-semibold text-charcoal-900">{t.registration.step1Title}</h2>
+            <Field label={t.registration.firstName} value={guest.first_name} onChange={(v) => setGuest({ ...guest, first_name: v })} required />
+            <Field label={t.registration.lastName} value={guest.last_name} onChange={(v) => setGuest({ ...guest, last_name: v })} required />
+            <Field label={t.registration.email} value={guest.email} onChange={(v) => setGuest({ ...guest, email: v })} type="email" />
+            <Field label={t.registration.phone} value={guest.phone} onChange={(v) => setGuest({ ...guest, phone: v })} type="tel" />
+            <Field label={t.registration.address} value={guest.address} onChange={(v) => setGuest({ ...guest, address: v })} />
+            <StepNav t={t} onBack={back} onNext={next} nextDisabled={!guest.first_name || !guest.last_name} />
+          </div>
+        )}
+
+        {step === "stay" && (
+          <div className="space-y-4">
+            <h2 className="font-semibold text-charcoal-900">{t.registration.step2Title}</h2>
+            <div className="rounded-lg bg-white border border-charcoal-100 p-4 space-y-2 text-sm">
+              <Row label={t.registration.confirmationNumber} value={reservation?.confirmation_number ?? "—"} />
+              <Row label={t.registration.arrivalDate} value={reservation?.arrival_date ?? "—"} />
+              <Row label={t.registration.departureDate} value={reservation?.departure_date ?? "—"} />
+              <Row label={t.registration.guestCount} value={String(reservation?.guest_count ?? 1)} />
+            </div>
+            {questions.length > 0 && (
+              <div className="space-y-3 pt-2">
+                {questions.map((q) => (
+                  <Field
+                    key={q.id}
+                    label={q.internal_key}
+                    value={answers[q.id] ?? ""}
+                    onChange={(v) => setAnswers({ ...answers, [q.id]: v })}
+                    required={q.required}
+                  />
+                ))}
+              </div>
+            )}
+            <StepNav t={t} onBack={back} onNext={next} />
+          </div>
+        )}
+
+        {step === "vehicle" && (
+          <div className="space-y-4">
+            <h2 className="font-semibold text-charcoal-900">{t.registration.step3Title}</h2>
+            <label className="flex items-center gap-2 text-sm text-charcoal-700">
+              <input type="checkbox" checked={hasVehicle} onChange={(e) => setHasVehicle(e.target.checked)} />
+              {t.registration.hasVehicle}
+            </label>
+            {hasVehicle && (
+              <div className="space-y-3">
+                <Field label={t.registration.vehicleMake} value={vehicle.make} onChange={(v) => setVehicle({ ...vehicle, make: v })} />
+                <Field label={t.registration.vehicleModel} value={vehicle.model} onChange={(v) => setVehicle({ ...vehicle, model: v })} />
+                <Field label={t.registration.vehicleColor} value={vehicle.color} onChange={(v) => setVehicle({ ...vehicle, color: v })} />
+                <Field label={t.registration.licensePlate} value={vehicle.license_plate} onChange={(v) => setVehicle({ ...vehicle, license_plate: v })} />
+                <label className="flex items-center gap-2 text-sm text-charcoal-700">
+                  <input type="checkbox" checked={vehicle.parking_needed} onChange={(e) => setVehicle({ ...vehicle, parking_needed: e.target.checked })} />
+                  {t.registration.parkingNeeded}
+                </label>
+                <label className="flex items-center gap-2 text-sm text-charcoal-700">
+                  <input type="checkbox" checked={vehicle.valet_needed} onChange={(e) => setVehicle({ ...vehicle, valet_needed: e.target.checked })} />
+                  {t.registration.valetNeeded}
+                </label>
+              </div>
+            )}
+            <StepNav t={t} onBack={back} onNext={next} />
+          </div>
+        )}
+
+        {step === "policies" && (
+          <div className="space-y-4">
+            <h2 className="font-semibold text-charcoal-900">{t.registration.step4Title}</h2>
+            {policies.length === 0 ? (
+              <p className="text-sm text-charcoal-500">No policies to review.</p>
+            ) : (
+              policies.map((p) => (
+                <label key={p.id} className="flex items-start gap-2 text-sm text-charcoal-700 bg-white rounded-lg border border-charcoal-100 p-3">
+                  <input
+                    type="checkbox"
+                    className="mt-0.5"
+                    checked={!!acceptedPolicies[p.id]}
+                    onChange={(e) => setAcceptedPolicies({ ...acceptedPolicies, [p.id]: e.target.checked })}
+                  />
+                  <span>
+                    {t.registration.acknowledgePrefix} <strong>{p.policy_key}</strong> (v{p.version})
+                    {p.required && <span className="text-red-500"> *</span>}
+                  </span>
+                </label>
+              ))
+            )}
+            <StepNav t={t} onBack={back} onNext={next} />
+          </div>
+        )}
+
+        {step === "signature" && (
+          <div className="space-y-4">
+            <h2 className="font-semibold text-charcoal-900">{t.registration.step5Title}</h2>
+            <p className="text-sm text-charcoal-500">{t.registration.signaturePrompt}</p>
+            <SignaturePad onChange={(dataUrl) => setSignatureCaptured(!!dataUrl)} />
+            <div className="flex items-center justify-between pt-2">
+              <button onClick={back} className="text-sm text-charcoal-500">{t.common.back}</button>
+              <button
+                onClick={handleSubmit}
+                disabled={submitting || !signatureCaptured}
+                className="px-5 py-2.5 rounded-lg bg-charcoal-900 text-white text-sm font-medium disabled:opacity-40"
+              >
+                {submitting ? t.common.loading : t.registration.completeRegistration}
+              </button>
+            </div>
+          </div>
+        )}
+
+        {step === "done" && (
+          <div className="text-center py-10">
+            <p className="text-lg font-semibold text-charcoal-900 mb-2">{t.registration.successTitle}</p>
+            <p className="text-sm text-charcoal-500">{t.registration.successBody}</p>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
+
+function Field({
+  label,
+  value,
+  onChange,
+  type = "text",
+  required,
+}: {
+  label: string;
+  value: string;
+  onChange: (v: string) => void;
+  type?: string;
+  required?: boolean;
+}) {
+  return (
+    <div>
+      <label className="block text-sm font-medium text-charcoal-700 mb-1">
+        {label} {required && <span className="text-red-500">*</span>}
+      </label>
+      <input
+        type={type}
+        value={value}
+        onChange={(e) => onChange(e.target.value)}
+        className="w-full h-11 rounded-lg border border-charcoal-200 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-gold-400"
+      />
+    </div>
+  );
+}
+
+function Row({ label, value }: { label: string; value: string }) {
+  return (
+    <div className="flex justify-between">
+      <span className="text-charcoal-500">{label}</span>
+      <span className="font-medium text-charcoal-800">{value}</span>
+    </div>
+  );
+}
+
+function StepNav({
+  t,
+  onBack,
+  onNext,
+  nextDisabled,
+}: {
+  t: typeof import("../../../messages/en.json");
+  onBack: () => void;
+  onNext: () => void;
+  nextDisabled?: boolean;
+}) {
+  return (
+    <div className="flex items-center justify-between pt-2">
+      <button onClick={onBack} className="text-sm text-charcoal-500">{t.common.back}</button>
+      <button
+        onClick={onNext}
+        disabled={nextDisabled}
+        className="px-5 py-2.5 rounded-lg bg-charcoal-900 text-white text-sm font-medium disabled:opacity-40"
+      >
+        {t.common.next}
+      </button>
+    </div>
+  );
+}
