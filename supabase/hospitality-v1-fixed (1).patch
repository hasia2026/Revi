+-- CUE Hospitality — Schema Gate approved version
+-- Run manually in Supabase SQL Editor, same as every prior migration.
+--
+-- Security model (see docs/Architecture.md "Hospitality" section once
+-- committed): staff tables use is_business_member() RLS exactly like the
+-- rest of CUE. Guest-facing tables (guests, reservations, and everything
+-- under a reservation) have RLS enabled but NO anonymous-role policy —
+-- guest access happens exclusively through a server-side token-validation
+-- route using the service role key, never a browser Supabase client.
+
+-- ============================================================
+-- Rooms — minimum canonical room identity, not a PMS
+-- ============================================================
+create table if not exists public.rooms (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  room_number text not null,
+  floor text,
+  room_type text,
+  active boolean not null default true,
+  created_at timestamptz not null default now(),
+  unique (business_id, room_number)
+);
+
+alter table public.rooms enable row level security;
+create policy "Members manage rooms" on public.rooms for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.rooms to authenticated;
+
+-- ============================================================
+-- Guests — reusable person, no stay-specific data
+-- ============================================================
+create table if not exists public.guests (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  first_name text not null,
+  last_name text not null,
+  email text,
+  phone text,
+  address text,
+  preferred_language text not null default 'en',
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+alter table public.guests enable row level security;
+-- Staff-only. No anonymous policy — see security note above.
+create policy "Members manage guests" on public.guests for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.guests to authenticated;
+
+-- ============================================================
+-- Reservations — one stay
+-- ============================================================
+create table if not exists public.reservations (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  primary_guest_id uuid references public.guests(id) on delete set null,
+  confirmation_number text,
+  arrival_date date not null,
+  departure_date date not null,
+  guest_count integer not null default 1,
+  reservation_status text not null default 'pending' check (reservation_status in ('pending', 'verified', 'cancelled')),
+  registration_status text not null default 'not_started' check (registration_status in ('not_started', 'in_progress', 'completed')),
+  id_verification_status text not null default 'pending' check (id_verification_status in ('pending', 'verified')),
+  verified_by uuid references auth.users(id) on delete set null,
+  verified_at timestamptz,
+  room_id uuid references public.rooms(id) on delete set null,
+  key_status text not null default 'not_issued' check (key_status in ('not_issued', 'issued')),
+  checked_in_at timestamptz,
+  checked_out_at timestamptz,
+  preferred_language_override text,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+alter table public.reservations enable row level security;
+create policy "Members manage reservations" on public.reservations for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.reservations to authenticated;
+
+-- ============================================================
+-- Reservation guests — authoritative stay membership (primary + additional)
+-- ============================================================
+create table if not exists public.reservation_guests (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  reservation_id uuid not null references public.reservations(id) on delete cascade,
+  guest_id uuid not null references public.guests(id) on delete cascade,
+  role text not null default 'additional' check (role in ('primary', 'additional')),
+  created_at timestamptz not null default now(),
+  unique (reservation_id, guest_id)
+);
+
+alter table public.reservation_guests enable row level security;
+create policy "Members manage reservation guests" on public.reservation_guests for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.reservation_guests to authenticated;
+
+-- ============================================================
+-- Registration questions (per-business config) + answers (per-stay)
+-- ============================================================
+create table if not exists public.registration_questions (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  internal_key text not null,
+  field_type text not null default 'text' check (field_type in ('text', 'select', 'checkbox', 'date')),
+  required boolean not null default false,
+  active boolean not null default true,
+  sort_order integer not null default 0,
+  options jsonb not null default '[]'::jsonb,
+  created_at timestamptz not null default now(),
+  unique (business_id, internal_key)
+);
+
+alter table public.registration_questions enable row level security;
+create policy "Members manage registration questions" on public.registration_questions for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.registration_questions to authenticated;
+
+create table if not exists public.registration_answers (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  reservation_id uuid not null references public.reservations(id) on delete cascade,
+  guest_id uuid references public.guests(id) on delete set null,
+  question_id uuid not null references public.registration_questions(id) on delete cascade,
+  value text,
+  answered_at timestamptz not null default now()
+);
+
+alter table public.registration_answers enable row level security;
+-- Staff read via is_business_member. Guest WRITE happens exclusively via
+-- the server-side token route (service role), which bypasses RLS by
+-- design at that layer — no anonymous policy needed or wanted here.
+create policy "Members manage registration answers" on public.registration_answers for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.registration_answers to authenticated;
+
+-- ============================================================
+-- Registration policies (immutable, versioned) + acknowledgements
+-- ============================================================
+create table if not exists public.registration_policies (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  policy_key text not null,
+  version integer not null,
+  required boolean not null default true,
+  active boolean not null default true,
+  effective_at timestamptz not null default now(),
+  created_at timestamptz not null default now(),
+  unique (business_id, policy_key, version)
+);
+
+alter table public.registration_policies enable row level security;
+create policy "Members manage registration policies" on public.registration_policies for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.registration_policies to authenticated;
+
+create table if not exists public.registration_acknowledgements (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  reservation_id uuid not null references public.reservations(id) on delete cascade,
+  guest_id uuid references public.guests(id) on delete set null,
+  policy_id uuid not null references public.registration_policies(id) on delete restrict,
+  policy_version integer not null,
+  accepted boolean not null default false,
+  accepted_at timestamptz,
+  signature_file_id uuid references public.files(id) on delete set null,
+  created_at timestamptz not null default now()
+);
+
+alter table public.registration_acknowledgements enable row level security;
+create policy "Members manage registration acknowledgements" on public.registration_acknowledgements for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.registration_acknowledgements to authenticated;
+
+-- ============================================================
+-- Reservation vehicles + Valet (own lifecycle)
+-- ============================================================
+create table if not exists public.reservation_vehicles (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  reservation_id uuid not null references public.reservations(id) on delete cascade,
+  guest_id uuid references public.guests(id) on delete set null,
+  make text,
+  model text,
+  color text,
+  license_plate text,
+  state_or_region text,
+  parking_needed boolean not null default false,
+  valet_needed boolean not null default false,
+  created_at timestamptz not null default now()
+);
+
+alter table public.reservation_vehicles enable row level security;
+create policy "Members manage reservation vehicles" on public.reservation_vehicles for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.reservation_vehicles to authenticated;
+
+create table if not exists public.valet_records (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  reservation_id uuid not null references public.reservations(id) on delete cascade,
+  vehicle_id uuid not null references public.reservation_vehicles(id) on delete cascade,
+  status text not null default 'received' check (status in ('received', 'parked', 'requested', 'retrieval_queue', 'retrieving', 'delivered')),
+  parking_location text,
+  ticket_number text,
+  assigned_to uuid references auth.users(id) on delete set null,
+  received_at timestamptz not null default now(),
+  parked_at timestamptz,
+  requested_at timestamptz,
+  retrieving_at timestamptz,
+  delivered_at timestamptz,
+  notes text
+);
+
+alter table public.valet_records enable row level security;
+create policy "Members manage valet records" on public.valet_records for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.valet_records to authenticated;
+
+-- ============================================================
+-- Guest requests, Housekeeping, Maintenance, Shift handoff
+-- ============================================================
+create table if not exists public.guest_requests (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  reservation_id uuid references public.reservations(id) on delete set null,
+  room_id uuid references public.rooms(id) on delete set null,
+  category text not null default 'general',
+  status text not null default 'new' check (status in ('new', 'assigned', 'in_progress', 'completed')),
+  priority text not null default 'normal' check (priority in ('low', 'normal', 'high', 'urgent')),
+  assigned_to uuid references auth.users(id) on delete set null,
+  notes text,
+  related_entity_type text,
+  related_entity_id uuid,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+alter table public.guest_requests enable row level security;
+create policy "Members manage guest requests" on public.guest_requests for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.guest_requests to authenticated;
+
+create table if not exists public.housekeeping_tasks (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  room_id uuid references public.rooms(id) on delete set null,
+  reservation_id uuid references public.reservations(id) on delete set null,
+  status text not null default 'needs_service' check (status in ('needs_service', 'assigned', 'in_progress', 'completed', 'ready')),
+  assigned_to uuid references auth.users(id) on delete set null,
+  priority text not null default 'normal' check (priority in ('low', 'normal', 'high', 'urgent')),
+  notes text,
+  photo_file_id uuid references public.files(id) on delete set null,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+alter table public.housekeeping_tasks enable row level security;
+create policy "Members manage housekeeping tasks" on public.housekeeping_tasks for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.housekeeping_tasks to authenticated;
+
+create table if not exists public.maintenance_tickets (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  room_id uuid references public.rooms(id) on delete set null,
+  location text,
+  status text not null default 'reported' check (status in ('reported', 'assigned', 'in_progress', 'resolved')),
+  assigned_to uuid references auth.users(id) on delete set null,
+  priority text not null default 'normal' check (priority in ('low', 'normal', 'high', 'urgent')),
+  notes text,
+  photo_file_id uuid references public.files(id) on delete set null,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+
+alter table public.maintenance_tickets enable row level security;
+create policy "Members manage maintenance tickets" on public.maintenance_tickets for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.maintenance_tickets to authenticated;
+
+create table if not exists public.shift_handoff_items (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  category text not null default 'general',
+  description text not null,
+  room_id uuid references public.rooms(id) on delete set null,
+  status text not null default 'open' check (status in ('open', 'resolved')),
+  created_by uuid references auth.users(id) on delete set null,
+  resolved_by uuid references auth.users(id) on delete set null,
+  resolved_at timestamptz,
+  created_at timestamptz not null default now()
+);
+
+alter table public.shift_handoff_items enable row level security;
+create policy "Members manage shift handoff items" on public.shift_handoff_items for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.shift_handoff_items to authenticated;
+
+-- ============================================================
+-- Content translations — hotel-authored multilingual content.
+-- Separate from next-intl (product/UI strings). Compatibility layer:
+-- reads check here first, fall back to existing _en/_es columns where
+-- those still exist. No bulk migration of old tables required now.
+-- ============================================================
+create table if not exists public.content_translations (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  entity_type text not null,
+  entity_id uuid not null,
+  locale text not null,
+  field_name text not null,
+  translated_text text not null,
+  is_approved boolean not null default false,
+  translated_by uuid references auth.users(id) on delete set null,
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now(),
+  unique (business_id, entity_type, entity_id, locale, field_name)
+);
+
+alter table public.content_translations enable row level security;
+create policy "Members manage content translations" on public.content_translations for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.content_translations to authenticated;
+
+-- ============================================================
+-- Registration links — hashed token, no raw token ever stored.
+-- Valid until expired, revoked, or completed (not single-use-on-open).
+-- ============================================================
+create table if not exists public.registration_links (
+  id uuid primary key default gen_random_uuid(),
+  business_id uuid not null references public.businesses(id) on delete cascade,
+  reservation_id uuid not null references public.reservations(id) on delete cascade,
+  token_hash text not null unique,
+  expires_at timestamptz not null,
+  revoked_at timestamptz,
+  last_used_at timestamptz,
+  completed_at timestamptz,
+  created_at timestamptz not null default now()
+);
+
+alter table public.registration_links enable row level security;
+-- Staff can create/view links (to generate the QR code / send it).
+-- NO anonymous policy — the guest-facing route validates the token
+-- server-side using the service role key, never a browser client.
+create policy "Members manage registration links" on public.registration_links for all
+  using (is_business_member(business_id)) with check (is_business_member(business_id));
+grant select, insert, update, delete on public.registration_links to authenticated;
