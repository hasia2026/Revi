@@ -0,0 +1,43 @@
+import { redirect } from "next/navigation";
+import { createClient } from "@/lib/supabase/server";
+import { TopBar } from "@/components/layout/TopBar";
+import { ArrivalBoard } from "@/components/hospitality/ArrivalBoard";
+
+export default async function ArrivalsPage() {
+  const supabase = await createClient();
+  const { data: { user } } = await supabase.auth.getUser();
+  if (!user) redirect("/login");
+
+  const [profileRes, memberRes] = await Promise.all([
+    supabase.from("profiles").select("full_name").eq("id", user.id).maybeSingle(),
+    supabase.from("business_members").select("business_id").eq("user_id", user.id).limit(1).maybeSingle(),
+  ]);
+
+  const businessId = memberRes.data?.business_id;
+  if (!businessId) redirect("/setup");
+
+  const [reservationsRes, guestsRes, roomsRes] = await Promise.all([
+    supabase.from("reservations").select("*").eq("business_id", businessId).order("arrival_date", { ascending: true }),
+    supabase.from("reservation_guests").select("reservation_id, guests(first_name, last_name)").eq("business_id", businessId),
+    supabase.from("rooms").select("*").eq("business_id", businessId).eq("active", true).order("room_number"),
+  ]);
+
+  return (
+    <div className="flex flex-col h-full overflow-hidden">
+      <TopBar
+        title="Front Desk — Arrivals"
+        subtitle="Registration through check-in, one board"
+        userName={profileRes.data?.full_name}
+        userEmail={user.email}
+      />
+      <div className="flex-1 overflow-y-auto">
+        <ArrivalBoard
+          businessId={businessId}
+          initialReservations={reservationsRes.data ?? []}
+          reservationGuests={guestsRes.data ?? []}
+          rooms={roomsRes.data ?? []}
+        />
+      </div>
+    </div>
+  );
+}
diff --git a/src/app/api/guest-registration/[token]/route.ts b/src/app/api/guest-registration/[token]/route.ts
new file mode 100644
index 0000000..50ce74a
--- /dev/null
+++ b/src/app/api/guest-registration/[token]/route.ts
@@ -0,0 +1,183 @@
+import { NextResponse } from "next/server";
+import { createServiceRoleClient } from "@/lib/supabase/service-role";
+import { validateRegistrationToken, markRegistrationLinkCompleted } from "@/lib/hospitality/registration-token";
+import { isRateLimited, recordAttempt } from "@/lib/hospitality/rate-limit";
+
+function errorResponse(reason: string, status: number) {
+  return NextResponse.json({ error: reason }, { status });
+}
+
+/**
+ * GET: loads exactly what the registration form needs to render —
+ * business name, reservation basics, active questions, active policies,
+ * and any previously-saved answers (for a guest resuming a partial
+ * registration). Nothing beyond this scope is ever returned.
+ */
+export async function GET(request: Request, { params }: { params: Promise<{ token: string }> }) {
+  const { token } = await params;
+  const ip = request.headers.get("x-forwarded-for") ?? "unknown";
+
+  if (isRateLimited(`get:${ip}`)) return errorResponse("rate_limited", 429);
+  recordAttempt(`get:${ip}`);
+
+  const result = await validateRegistrationToken(token);
+  if (!result.valid) return errorResponse(result.reason, 404);
+
+  const supabase = createServiceRoleClient();
+  const { link } = result;
+
+  const [businessRes, reservationRes, questionsRes, policiesRes, answersRes] = await Promise.all([
+    supabase.from("businesses").select("id, name").eq("id", link.business_id).single(),
+    supabase.from("reservations").select("*").eq("id", link.reservation_id).single(),
+    supabase.from("registration_questions").select("*").eq("business_id", link.business_id).eq("active", true).order("sort_order"),
+    supabase.from("registration_policies").select("*").eq("business_id", link.business_id).eq("active", true),
+    supabase.from("registration_answers").select("*").eq("reservation_id", link.reservation_id),
+  ]);
+
+  return NextResponse.json({
+    business: businessRes.data,
+    reservation: reservationRes.data,
+    questions: questionsRes.data ?? [],
+    policies: policiesRes.data ?? [],
+    existingAnswers: answersRes.data ?? [],
+  });
+}
+
+type RegistrationSubmission = {
+  guest: {
+    first_name: string;
+    last_name: string;
+    email?: string;
+    phone?: string;
+    address?: string;
+    preferred_language: string;
+  };
+  vehicle?: {
+    make?: string;
+    model?: string;
+    color?: string;
+    license_plate?: string;
+    state_or_region?: string;
+    parking_needed?: boolean;
+    valet_needed?: boolean;
+  };
+  answers?: { question_id: string; value: string }[];
+  acknowledgements?: { policy_id: string; policy_version: number; accepted: boolean }[];
+};
+
+/**
+ * POST: writes exactly one guest's registration for exactly the
+ * reservation the token resolved to. The service-role client is used
+ * for every write here — this handler IS the access-control layer;
+ * there is no RLS check downstream of this because there's no
+ * authenticated Supabase session to check against.
+ */
+export async function POST(request: Request, { params }: { params: Promise<{ token: string }> }) {
+  const { token } = await params;
+  const ip = request.headers.get("x-forwarded-for") ?? "unknown";
+
+  if (isRateLimited(`post:${ip}`)) return errorResponse("rate_limited", 429);
+  recordAttempt(`post:${ip}`);
+
+  const result = await validateRegistrationToken(token);
+  if (!result.valid) return errorResponse(result.reason, 404);
+
+  const { link } = result;
+  const body = (await request.json()) as RegistrationSubmission;
+
+  if (!body.guest?.first_name || !body.guest?.last_name) {
+    return errorResponse("missing_required_fields", 400);
+  }
+
+  const supabase = createServiceRoleClient();
+
+  // Create the guest record and link it to the reservation.
+  const { data: guest, error: guestError } = await supabase
+    .from("guests")
+    .insert({
+      business_id: link.business_id,
+      first_name: body.guest.first_name,
+      last_name: body.guest.last_name,
+      email: body.guest.email || null,
+      phone: body.guest.phone || null,
+      address: body.guest.address || null,
+      preferred_language: body.guest.preferred_language || "en",
+    })
+    .select("id")
+    .single();
+
+  if (guestError || !guest) return errorResponse("guest_create_failed", 500);
+
+  await supabase.from("reservation_guests").insert({
+    business_id: link.business_id,
+    reservation_id: link.reservation_id,
+    guest_id: guest.id,
+    role: "primary",
+  });
+
+  await supabase
+    .from("reservations")
+    .update({ primary_guest_id: guest.id, registration_status: "completed" })
+    .eq("id", link.reservation_id);
+
+  if (body.vehicle && (body.vehicle.make || body.vehicle.license_plate)) {
+    const { data: vehicle } = await supabase
+      .from("reservation_vehicles")
+      .insert({
+        business_id: link.business_id,
+        reservation_id: link.reservation_id,
+        guest_id: guest.id,
+        make: body.vehicle.make || null,
+        model: body.vehicle.model || null,
+        color: body.vehicle.color || null,
+        license_plate: body.vehicle.license_plate || null,
+        state_or_region: body.vehicle.state_or_region || null,
+        parking_needed: body.vehicle.parking_needed ?? false,
+        valet_needed: body.vehicle.valet_needed ?? false,
+      })
+      .select("id")
+      .single();
+
+    // Valet record creation happens here, not in the Valet module — a
+    // guest requesting valet at registration should already be in the
+    // Received state by the time Valet screens exist to show it.
+    if (vehicle && body.vehicle.valet_needed) {
+      await supabase.from("valet_records").insert({
+        business_id: link.business_id,
+        reservation_id: link.reservation_id,
+        vehicle_id: vehicle.id,
+        status: "received",
+      });
+    }
+  }
+
+  if (body.answers?.length) {
+    await supabase.from("registration_answers").insert(
+      body.answers.map((a) => ({
+        business_id: link.business_id,
+        reservation_id: link.reservation_id,
+        guest_id: guest.id,
+        question_id: a.question_id,
+        value: a.value,
+      }))
+    );
+  }
+
+  if (body.acknowledgements?.length) {
+    await supabase.from("registration_acknowledgements").insert(
+      body.acknowledgements.map((ack) => ({
+        business_id: link.business_id,
+        reservation_id: link.reservation_id,
+        guest_id: guest.id,
+        policy_id: ack.policy_id,
+        policy_version: ack.policy_version,
+        accepted: ack.accepted,
+        accepted_at: ack.accepted ? new Date().toISOString() : null,
+      }))
+    );
+  }
+
+  await markRegistrationLinkCompleted(link.id);
+
+  return NextResponse.json({ success: true, reservationId: link.reservation_id });
+}
