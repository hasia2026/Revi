+++ b/src/lib/hospitality/actions.ts
@@ -0,0 +1,88 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { createClient } from "@/lib/supabase/server";
+import { createRegistrationLink } from "@/lib/hospitality/registration-token";
+
+/**
+ * All of these run as the authenticated staff member, through the
+ * normal server client — RLS via is_business_member() applies exactly
+ * like every other CUE table. This file is NOT part of the guest
+ * security boundary; that's registration-token.ts + the API route,
+ * used exclusively by staff-facing UI.
+ */
+
+export async function createReservationAndLink(input: {
+  businessId: string;
+  confirmationNumber: string;
+  arrivalDate: string;
+  departureDate: string;
+  guestCount: number;
+}) {
+  const supabase = await createClient();
+
+  const { data: reservation, error } = await supabase
+    .from("reservations")
+    .insert({
+      business_id: input.businessId,
+      confirmation_number: input.confirmationNumber || null,
+      arrival_date: input.arrivalDate,
+      departure_date: input.departureDate,
+      guest_count: input.guestCount,
+    })
+    .select("id")
+    .single();
+
+  if (error || !reservation) {
+    return { error: error?.message ?? "Failed to create reservation" };
+  }
+
+  const { rawToken } = await createRegistrationLink(input.businessId, reservation.id);
+
+  revalidatePath("/arrivals");
+  return { reservationId: reservation.id, rawToken };
+}
+
+export async function verifyReservationId(reservationId: string, userId: string) {
+  const supabase = await createClient();
+  const { error } = await supabase
+    .from("reservations")
+    .update({ id_verification_status: "verified", verified_by: userId, verified_at: new Date().toISOString() })
+    .eq("id", reservationId);
+  revalidatePath("/arrivals");
+  return { error: error?.message };
+}
+
+export async function verifyReservationBooking(reservationId: string) {
+  const supabase = await createClient();
+  const { error } = await supabase
+    .from("reservations")
+    .update({ reservation_status: "verified" })
+    .eq("id", reservationId);
+  revalidatePath("/arrivals");
+  return { error: error?.message };
+}
+
+export async function assignRoom(reservationId: string, roomId: string) {
+  const supabase = await createClient();
+  const { error } = await supabase.from("reservations").update({ room_id: roomId }).eq("id", reservationId);
+  revalidatePath("/arrivals");
+  return { error: error?.message };
+}
+
+export async function markKeyIssued(reservationId: string) {
+  const supabase = await createClient();
+  const { error } = await supabase.from("reservations").update({ key_status: "issued" }).eq("id", reservationId);
+  revalidatePath("/arrivals");
+  return { error: error?.message };
+}
+
+export async function completeCheckIn(reservationId: string) {
+  const supabase = await createClient();
+  const { error } = await supabase
+    .from("reservations")
+    .update({ checked_in_at: new Date().toISOString() })
+    .eq("id", reservationId);
+  revalidatePath("/arrivals");
+  return { error: error?.message };
+}
diff --git a/src/lib/hospitality/rate-limit.ts b/src/lib/hospitality/rate-limit.ts
new file mode 100644
index 0000000..1838e6c
--- /dev/null
+++ b/src/lib/hospitality/rate-limit.ts
@@ -0,0 +1,33 @@
+import "server-only";
+
+/**
+ * Deliberately minimal, and deliberately NOT a real production rate
+ * limiter — flagging this honestly rather than pretending it's more
+ * than it is. This Map lives in the memory of one serverless function
+ * instance; Vercel can and will spin up multiple instances under load,
+ * each with its own empty Map, so this does NOT reliably stop a
+ * determined attacker across a real deployment. What it does do: stop
+ * a naive script hammering one instance, which is a reasonable bar for
+ * a pilot demo. Before real production traffic, replace with a shared
+ * store (Upstash Redis is the standard pairing with Vercel) — that's a
+ * swap-the-implementation change, not a rearchitecture, since callers
+ * only see checkRateLimit()/recordAttempt().
+ */
+
+const attempts = new Map<string, number[]>();
+
+const WINDOW_MS = 60_000;
+const MAX_ATTEMPTS_PER_WINDOW = 10;
+
+export function isRateLimited(key: string): boolean {
+  const now = Date.now();
+  const recent = (attempts.get(key) ?? []).filter((t) => now - t < WINDOW_MS);
+  return recent.length >= MAX_ATTEMPTS_PER_WINDOW;
+}
+
+export function recordAttempt(key: string) {
+  const now = Date.now();
+  const recent = (attempts.get(key) ?? []).filter((t) => now - t < WINDOW_MS);
+  recent.push(now);
+  attempts.set(key, recent);
+}
diff --git a/src/lib/hospitality/registration-token.ts b/src/lib/hospitality/registration-token.ts
new file mode 100644
index 0000000..e0ceae3
--- /dev/null
+++ b/src/lib/hospitality/registration-token.ts
@@ -0,0 +1,111 @@
+import "server-only";
+import { randomBytes, createHash, timingSafeEqual } from "crypto";
+import { createServiceRoleClient } from "@/lib/supabase/service-role";
+import type { RegistrationLink } from "@/lib/cu3/hospitality-types";
+
+const TOKEN_BYTES = 32; // 256 bits
+const DEFAULT_EXPIRY_DAYS = 14;
+
+export function generateRawToken(): string {
+  return randomBytes(TOKEN_BYTES).toString("base64url");
+}
+
+export function hashToken(rawToken: string): string {
+  return createHash("sha256").update(rawToken).digest("hex");
+}
+
+/**
+ * Constant-time comparison so a timing attack can't be used to guess a
+ * valid hash byte-by-byte. Overkill for a 256-bit token in practice, but
+ * cheap to do correctly.
+ */
+function hashesMatch(a: string, b: string): boolean {
+  const bufA = Buffer.from(a, "hex");
+  const bufB = Buffer.from(b, "hex");
+  if (bufA.length !== bufB.length) return false;
+  return timingSafeEqual(bufA, bufB);
+}
+
+/**
+ * Staff-facing: creates a new registration link for a reservation and
+ * returns the ONE-TIME-VISIBLE raw token to embed in a URL/QR code. The
+ * raw token is never stored — only its hash is. If this raw value is
+ * lost, generate a new link; there's no way to recover it from the DB.
+ */
+export async function createRegistrationLink(
+  businessId: string,
+  reservationId: string,
+  expiryDays: number = DEFAULT_EXPIRY_DAYS
+): Promise<{ rawToken: string; linkId: string }> {
+  const supabase = createServiceRoleClient();
+  const rawToken = generateRawToken();
+  const tokenHash = hashToken(rawToken);
+  const expiresAt = new Date(Date.now() + expiryDays * 86_400_000).toISOString();
+
+  const { data, error } = await supabase
+    .from("registration_links")
+    .insert({
+      business_id: businessId,
+      reservation_id: reservationId,
+      token_hash: tokenHash,
+      expires_at: expiresAt,
+    })
+    .select("id")
+    .single();
+
+  if (error || !data) {
+    throw new Error(`Failed to create registration link: ${error?.message}`);
+  }
+
+  return { rawToken, linkId: data.id };
+}
+
+export type TokenValidationResult =
+  | { valid: true; link: RegistrationLink }
+  | { valid: false; reason: "not_found" | "expired" | "revoked" | "completed" };
+
+/**
+ * The single gate every guest-facing read/write must pass through.
+ * Valid until expired, revoked, or completed — NOT single-use-on-open,
+ * per the explicit correction that a guest may start registration, stop
+ * partway, and come back later.
+ */
+export async function validateRegistrationToken(rawToken: string): Promise<TokenValidationResult> {
+  const supabase = createServiceRoleClient();
+  const tokenHash = hashToken(rawToken);
+
+  const { data: links } = await supabase
+    .from("registration_links")
+    .select("*")
+    .limit(50); // small table per business realistically; see note below
+
+  // Fetched broadly then compared in-memory with a constant-time check,
+  // rather than an equality filter in the query, so the hash comparison
+  // itself isn't timing-observable via query planning. For a pilot's
+  // scale this is fine; if link volume grows, an indexed exact-match
+  // lookup is still safe (hashes aren't secret once one is known — the
+  // RAW token is the secret, and it's never in the database at all).
+  const link = (links ?? []).find((l) => hashesMatch(l.token_hash, tokenHash)) as
+    | RegistrationLink
+    | undefined;
+
+  if (!link) return { valid: false, reason: "not_found" };
+  if (link.revoked_at) return { valid: false, reason: "revoked" };
+  if (link.completed_at) return { valid: false, reason: "completed" };
+  if (new Date(link.expires_at).getTime() < Date.now()) return { valid: false, reason: "expired" };
+
+  await supabase
+    .from("registration_links")
+    .update({ last_used_at: new Date().toISOString() })
+    .eq("id", link.id);
+
+  return { valid: true, link };
+}
+
+export async function markRegistrationLinkCompleted(linkId: string) {
+  const supabase = createServiceRoleClient();
+  await supabase
+    .from("registration_links")
+    .update({ completed_at: new Date().toISOString() })
+    .eq("id", linkId);
+}
