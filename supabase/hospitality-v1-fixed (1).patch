+"use client";
+
+import { useState } from "react";
+import { toast } from "sonner";
+import { CheckCircle2, Circle, Plus, Copy } from "lucide-react";
+import { createClient } from "@/lib/supabase/client";
+import { Button } from "@/components/ui/Button";
+import { Input } from "@/components/ui/Input";
+import { Select } from "@/components/ui/Select";
+import { Modal } from "@/components/ui/Modal";
+import { EmptyState } from "@/components/ui/EmptyState";
+import { cn } from "@/lib/utils";
+import {
+  createReservationAndLink,
+  verifyReservationId,
+  verifyReservationBooking,
+  assignRoom,
+  markKeyIssued,
+  completeCheckIn,
+} from "@/lib/hospitality/actions";
+import type { Reservation, Room } from "@/lib/cu3/hospitality-types";
+
+type ReservationGuestRow = { reservation_id: string; guests: { first_name: string; last_name: string } | null };
+
+export function ArrivalBoard({
+  businessId,
+  initialReservations,
+  reservationGuests,
+  rooms,
+}: {
+  businessId: string;
+  initialReservations: Reservation[];
+  reservationGuests: ReservationGuestRow[];
+  rooms: Room[];
+}) {
+  const [reservations, setReservations] = useState(initialReservations);
+  const [newOpen, setNewOpen] = useState(false);
+  const [creating, setCreating] = useState(false);
+  const [generatedLink, setGeneratedLink] = useState<string | null>(null);
+  const [form, setForm] = useState({ confirmationNumber: "", arrivalDate: "", departureDate: "", guestCount: "1" });
+
+  function guestName(reservationId: string): string | null {
+    const row = reservationGuests.find((g) => g.reservation_id === reservationId);
+    if (!row?.guests) return null;
+    return `${row.guests.first_name} ${row.guests.last_name}`;
+  }
+
+  async function handleCreate() {
+    if (!form.arrivalDate || !form.departureDate) {
+      toast.error("Arrival and departure dates required");
+      return;
+    }
+    setCreating(true);
+    const result = await createReservationAndLink({
+      businessId,
+      confirmationNumber: form.confirmationNumber,
+      arrivalDate: form.arrivalDate,
+      departureDate: form.departureDate,
+      guestCount: Number(form.guestCount) || 1,
+    });
+    setCreating(false);
+
+    if ("error" in result) {
+      toast.error(result.error);
+      return;
+    }
+
+    const url = `${window.location.origin}/register/${result.rawToken}`;
+    setGeneratedLink(url);
+
+    const supabase = createClient();
+    const { data } = await supabase.from("reservations").select("*").eq("id", result.reservationId).single();
+    if (data) setReservations((prev) => [data, ...prev]);
+  }
+
+  function closeNewModal() {
+    setNewOpen(false);
+    setGeneratedLink(null);
+    setForm({ confirmationNumber: "", arrivalDate: "", departureDate: "", guestCount: "1" });
+  }
+
+  async function handleVerifyId(reservationId: string) {
+    const supabase = createClient();
+    const { data: { user } } = await supabase.auth.getUser();
+    if (!user) return;
+    setReservations((prev) => prev.map((r) => (r.id === reservationId ? { ...r, id_verification_status: "verified" } : r)));
+    await verifyReservationId(reservationId, user.id);
+  }
+
+  async function handleVerifyReservation(reservationId: string) {
+    setReservations((prev) => prev.map((r) => (r.id === reservationId ? { ...r, reservation_status: "verified" } : r)));
+    await verifyReservationBooking(reservationId);
+  }
+
+  async function handleAssignRoom(reservationId: string, roomId: string) {
+    setReservations((prev) => prev.map((r) => (r.id === reservationId ? { ...r, room_id: roomId } : r)));
+    await assignRoom(reservationId, roomId);
+  }
+
+  async function handleKeyIssued(reservationId: string) {
+    setReservations((prev) => prev.map((r) => (r.id === reservationId ? { ...r, key_status: "issued" } : r)));
+    await markKeyIssued(reservationId);
+  }
+
+  async function handleCheckIn(reservationId: string) {
+    setReservations((prev) => prev.map((r) => (r.id === reservationId ? { ...r, checked_in_at: new Date().toISOString() } : r)));
+    const result = await completeCheckIn(reservationId);
+    if (result.error) toast.error(result.error);
+    else toast.success("Guest checked in");
+  }
+
+  return (
+    <div className="p-6 space-y-4">
+      <div className="flex items-center justify-between">
+        <p className="text-sm text-charcoal-500">{reservations.length} reservations</p>
+        <Button size="sm" onClick={() => setNewOpen(true)}>
+          <Plus className="h-4 w-4" /> New Reservation
+        </Button>
+      </div>
+
+      {reservations.length === 0 ? (
+        <EmptyState icon={CheckCircle2} title="No arrivals yet" description="Create a reservation to generate a guest registration link." />
+      ) : (
+        <div className="space-y-3">
+          {reservations.map((r) => {
+            const name = guestName(r.id);
+            const readyForKey = r.registration_status === "completed" && r.id_verification_status === "verified" && r.reservation_status === "verified" && !!r.room_id;
+            const readyForCheckIn = readyForKey && r.key_status === "issued";
+
+            return (
+              <div key={r.id} className="bg-white border border-charcoal-100 rounded-xl p-4">
+                <div className="flex items-center justify-between mb-3">
+                  <div>
+                    <p className="font-semibold text-charcoal-900">{name ?? "Awaiting registration"}</p>
+                    <p className="text-xs text-charcoal-400">
+                      {r.confirmation_number ?? "No confirmation #"} · {r.arrival_date} → {r.departure_date}
+                    </p>
+                  </div>
+                  {r.checked_in_at ? (
+                    <span className="text-xs font-medium text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full">Checked in</span>
+                  ) : (
+                    <span className="text-xs font-medium text-charcoal-400 bg-charcoal-50 px-2.5 py-1 rounded-full">In progress</span>
+                  )}
+                </div>
+
+                <div className="grid grid-cols-2 sm:grid-cols-5 gap-2 text-xs">
+                  <StatusStep label="Registration" done={r.registration_status === "completed"} />
+                  <StatusStep
+                    label="ID Verified"
+                    done={r.id_verification_status === "verified"}
+                    action={r.id_verification_status !== "verified" ? () => handleVerifyId(r.id) : undefined}
+                  />
+                  <StatusStep
+                    label="Reservation"
+                    done={r.reservation_status === "verified"}
+                    action={r.reservation_status !== "verified" ? () => handleVerifyReservation(r.id) : undefined}
+                  />
+                  <div className="flex flex-col gap-1">
+                    <span className="text-charcoal-500">Room</span>
+                    <Select
+                      value={r.room_id ?? ""}
+                      onChange={(e) => handleAssignRoom(r.id, e.target.value)}
+                      options={rooms.map((room) => ({ value: room.id, label: room.room_number }))}
+                      placeholder="Assign…"
+                      className="h-8 text-xs"
+                    />
+                  </div>
+                  <StatusStep
+                    label="Key Issued"
+                    done={r.key_status === "issued"}
+                    action={r.key_status !== "issued" && r.room_id ? () => handleKeyIssued(r.id) : undefined}
+                  />
+                </div>
+
+                {readyForCheckIn && !r.checked_in_at && (
+                  <div className="mt-3 pt-3 border-t border-charcoal-100">
+                    <Button size="sm" onClick={() => handleCheckIn(r.id)}>Complete Check-In</Button>
+                  </div>
+                )}
+              </div>
+            );
+          })}
+        </div>
+      )}
+
+      <Modal open={newOpen} onClose={closeNewModal} title="New Reservation" size="sm">
+        {generatedLink ? (
+          <div className="space-y-3">
+            <p className="text-sm text-charcoal-700">Reservation created. Send this link to the guest:</p>
+            <div className="flex items-center gap-2">
+              <Input value={generatedLink} readOnly className="text-xs" />
+              <Button
+                size="sm"
+                variant="ghost"
+                onClick={() => {
+                  navigator.clipboard.writeText(generatedLink);
+                  toast.success("Link copied");
+                }}
+              >
+                <Copy className="h-4 w-4" />
+              </Button>
+            </div>
+            <p className="text-xs text-charcoal-400">
+              This link stays valid until the guest completes registration or it expires — it&apos;s safe to send even if they don&apos;t finish in one sitting.
+            </p>
+            <div className="flex justify-end">
+              <Button onClick={closeNewModal}>Done</Button>
+            </div>
+          </div>
+        ) : (
+          <div className="space-y-3">
+            <Input label="Confirmation number" value={form.confirmationNumber} onChange={(e) => setForm({ ...form, confirmationNumber: e.target.value })} />
+            <div className="grid grid-cols-2 gap-3">
+              <Input label="Arrival date" type="date" value={form.arrivalDate} onChange={(e) => setForm({ ...form, arrivalDate: e.target.value })} />
+              <Input label="Departure date" type="date" value={form.departureDate} onChange={(e) => setForm({ ...form, departureDate: e.target.value })} />
+            </div>
+            <Input label="Number of guests" type="number" min={1} value={form.guestCount} onChange={(e) => setForm({ ...form, guestCount: e.target.value })} />
+            <div className="flex justify-end gap-2 pt-2">
+              <Button variant="ghost" onClick={closeNewModal}>Cancel</Button>
+              <Button onClick={handleCreate} loading={creating}>Create &amp; Generate Link</Button>
+            </div>
+          </div>
+        )}
+      </Modal>
+    </div>
+  );
+}
+
+function StatusStep({ label, done, action }: { label: string; done: boolean; action?: () => void }) {
+  return (
+    <div className="flex flex-col gap-1">
+      <span className="text-charcoal-500">{label}</span>
+      <button
+        onClick={action}
+        disabled={!action}
+        className={cn(
+          "flex items-center gap-1 px-2 py-1.5 rounded-md border text-xs font-medium",
+          done ? "border-emerald-200 bg-emerald-50 text-emerald-700" : "border-charcoal-200 text-charcoal-500",
+          action && "hover:border-gold-300 cursor-pointer"
+        )}
+      >
+        {done ? <CheckCircle2 className="h-3.5 w-3.5" /> : <Circle className="h-3.5 w-3.5" />}
+        {done ? "Done" : action ? "Mark done" : "Pending"}
+      </button>
+    </div>
+  );
+}
