@@ -0,0 +1,31 @@
+import "server-only";
+import { createClient as createSupabaseClient } from "@supabase/supabase-js";
+
+/**
+ * Service-role client — bypasses RLS entirely. This is intentional and
+ * narrow: the ONLY caller of this should be the guest-registration token
+ * route, after it has independently validated a hashed token against
+ * registration_links. Never call this from anything that trusts
+ * unvalidated user input to determine which rows get touched.
+ *
+ * Never import this into a Client Component or anything that ships to
+ * the browser — "server-only" above makes that a build error if
+ * attempted, not just a convention.
+ */
+export function createServiceRoleClient() {
+  const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
+  const serviceKey = process.env.SUPABASE_SERVICE_ROLE_KEY;
+
+  if (!url || !serviceKey) {
+    throw new Error(
+      "Missing NEXT_PUBLIC_SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY. " +
+      "Set SUPABASE_SERVICE_ROLE_KEY in Vercel/local env — found under " +
+      "Supabase Project Settings > API > service_role key. Never expose " +
+      "this as a NEXT_PUBLIC_* variable."
+    );
+  }
+
+  return createSupabaseClient(url, serviceKey, {
+    auth: { autoRefreshToken: false, persistSession: false },
+  });
+}
