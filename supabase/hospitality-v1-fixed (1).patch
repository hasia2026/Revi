+import { validateRegistrationToken } from "@/lib/hospitality/registration-token";
+import { createServiceRoleClient } from "@/lib/supabase/service-role";
+import { RegistrationForm } from "@/components/hospitality/RegistrationForm";
+import { RegistrationLinkError } from "@/components/hospitality/RegistrationLinkError";
+
+export default async function GuestRegistrationPage({
+  params,
+}: {
+  params: Promise<{ token: string }>;
+}) {
+  const { token } = await params;
+  const result = await validateRegistrationToken(token);
+
+  if (!result.valid) {
+    return <RegistrationLinkError reason={result.reason} />;
+  }
+
+  const { link } = result;
+  const supabase = createServiceRoleClient();
+
+  const [businessRes, reservationRes, questionsRes, policiesRes] = await Promise.all([
+    supabase.from("businesses").select("id, name").eq("id", link.business_id).single(),
+    supabase.from("reservations").select("*").eq("id", link.reservation_id).single(),
+    supabase.from("registration_questions").select("*").eq("business_id", link.business_id).eq("active", true).order("sort_order"),
+    supabase.from("registration_policies").select("*").eq("business_id", link.business_id).eq("active", true),
+  ]);
+
+  if (reservationRes.data?.registration_status === "completed") {
+    return <RegistrationLinkError reason="completed" />;
+  }
+
+  return (
+    <RegistrationForm
+      token={token}
+      businessName={businessRes.data?.name ?? "Your hotel"}
+      reservation={reservationRes.data}
+      questions={questionsRes.data ?? []}
+      policies={policiesRes.data ?? []}
+    />
+  );
+}
